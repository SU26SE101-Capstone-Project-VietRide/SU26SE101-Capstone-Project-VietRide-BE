{
  "version": 2,
  "policy": "runtime-metadata-aligned-openapi",
  "services": {
    "identity": {
      "stack": "dotnet",
      "servicePrefix": "identity",
      "requireAllMutations": false,
      "expectedMutationCount": 34,
      "expectedRequiredCount": 6,
      "metadataAttributes": {
        "RequireIdempotency": "libs/dotnet/VietRide.Shared.Web/Idempotency/RequireIdempotencyAttribute.cs",
        "IdempotencyOpenApi": "libs/dotnet/VietRide.Shared.Web/Idempotency/IdempotencyOpenApiAttribute.cs"
      }
    },
    "trip": {
      "stack": "dotnet",
      "servicePrefix": "trip",
      "requireAllMutations": false,
      "expectedMutationCount": 50,
      "expectedRequiredCount": 28,
      "metadataAttributes": {
        "RequireIdempotency": "libs/dotnet/VietRide.Shared.Web/Idempotency/RequireIdempotencyAttribute.cs",
        "RequireIdempotencyKey": "apps/trip/src/VietRide.Trip.Api/Filters/RequireIdempotencyKeyAttribute.cs",
        "IdempotencyOpenApi": "libs/dotnet/VietRide.Shared.Web/Idempotency/IdempotencyOpenApiAttribute.cs"
      }
    },
    "booking": {
      "stack": "dotnet",
      "servicePrefix": "booking",
      "requireAllMutations": true,
      "expectedMutationCount": 26,
      "controllers": [
        "AdminVouchersController",
        "BookingsController",
        "BoardingController",
        "InternalVouchersController",
        "AdminCampaignsController",
        "OperatorVouchersController",
        "OperatorVoucherConsentsController"
      ],
      "exemptions": [
        {
          "method": "POST",
          "path": "/internal/v1/vouchers/validate",
          "reason": "Voucher validation is read-only and does not create a usage record."
        }
      ]
    },
    "payment": {
      "stack": "dotnet",
      "servicePrefix": "payment",
      "requireAllMutations": true,
      "expectedMutationCount": 14,
      "controllers": [
        "WalletController",
        "InternalWalletController",
        "InternalPaymentsController",
        "AdminFinancialController",
        "AdminInvoicesController",
        "Day38E2eJobsController"
      ],
      "exemptions": [
        {
          "method": "POST",
          "path": "/v1/payments/vnpay-topup-ipn",
          "reason": "VNPay IPN is authenticated and deduplicated by the provider transaction reference."
        },
        {
          "method": "POST",
          "path": "/v1/payments/vnpay-ipn",
          "reason": "VNPay IPN is authenticated and deduplicated by the provider transaction reference."
        },
        {
          "method": "POST",
          "path": "/v1/payments/subscription-vnpay-ipn",
          "reason": "VNPay IPN is authenticated and deduplicated by the provider transaction reference."
        }
      ]
    },
    "parcel": {
      "stack": "dotnet",
      "servicePrefix": "parcel",
      "requireAllMutations": true,
      "expectedMutationCount": 20,
      "controllers": [
        "AssistantParcelsController",
        "InternalParcelsController",
        "OperatorParcelRouteFaresController",
        "OperatorParcelsController",
        "ParcelsController",
        "ParcelDeliveryController"
      ],
      "exemptions": []
    },
    "notification": {
      "stack": "nestjs",
      "sourceDirectory": "apps/notification/src",
      "requiredDecorator": "ApiIdempotencyRequired",
      "decoratorFile": "apps/notification/src/swagger/idempotency.swagger.ts",
      "expectedMutationCount": 3,
      "expectedRequiredCount": 1
    }
  }
}
