{
  "info": {
    "name": "VietRide API",
    "description": "Cumulative VietRide API collection — the single graded deliverable run by the external reviewer (BE_TIMELINE_VU.md: 'external reviewer runs full Postman collection without errors'). Organized by domain folders; grow it per PR (timeline: 'update Postman collection') rather than adding per-day files. Placeholders only, no real secrets. Use the env file vietride.local.postman_environment.json for baseUrl + externally-supplied tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "passenger@example.com" },
    { "key": "password", "value": "ChangeMe123!" },
    { "key": "displayName", "value": "Passenger Example" },
    { "key": "phone", "value": "+84901234567" },
    { "key": "otpCode", "value": "123456" },
    { "key": "tokens", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "googleIdToken", "value": "<google-id-token>" },
    { "key": "systemAdminAccessToken", "value": "<system-admin-access-token>" },
    { "key": "operatorAdminAccessToken", "value": "<operator-admin-access-token>" },
    { "key": "createdAdminEmail", "value": "admin2@example.com" },
    { "key": "initialPasswordToken", "value": "<set-initial-password-token>" },
    { "key": "operatorUserId", "value": "<operator-user-id>" },
    { "key": "fcmToken", "value": "<fcm-token>" }
  ],
  "item": [
    {
      "name": "Identity — Auth (email/password)",
      "item": [
        {
          "name": "Register passenger",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"{{displayName}}\",\n  \"phone\": \"{{phone}}\"\n}"
            }
          }
        },
        {
          "name": "Verify registration email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/verify-email",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "verify-email"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{otpCode}}\",\n  \"purpose\": \"REGISTRATION\"\n}"
            }
          }
        },
        {
          "name": "Login passenger",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('ADR 0004 success envelope with token bundle', function () {",
                  "  pm.expect(body.success).to.equal(true);",
                  "  pm.expect(body.statusCode).to.equal(200);",
                  "  pm.expect(body.data).to.have.property('accessToken').that.is.a('string').and.is.not.empty;",
                  "  pm.expect(body.data).to.have.property('refreshToken').that.is.a('string').and.is.not.empty;",
                  "  pm.expect(body.data.user.status).to.equal('ACTIVE');",
                  "});",
                  "if (body && body.data) {",
                  "  pm.collectionVariables.set('tokens', JSON.stringify(body.data));",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken || '');",
                  "  pm.collectionVariables.set('refreshToken', body.data.refreshToken || '');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Refresh passenger token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Set initial password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "const expectedStatus = Number(pm.variables.get('expectedStatus') || 200);",
                  "const expectedErrorCode = pm.variables.get('expectedErrorCode') || '';",
                  "pm.test(`Status code is ${expectedStatus}`, function () {",
                  "  pm.response.to.have.status(expectedStatus);",
                  "});",
                  "pm.test('ADR 0004 envelope matches expected outcome', function () {",
                  "  pm.expect(body.statusCode).to.equal(expectedStatus);",
                  "  if (expectedStatus >= 200 && expectedStatus < 300) {",
                  "    pm.expect(body.success).to.equal(true);",
                  "    pm.expect(body.data).to.have.property('userId').that.is.a('string').and.is.not.empty;",
                  "    pm.expect(body.data).to.have.property('status', 'ACTIVE');",
                  "    pm.expect(body.meta).to.have.property('traceId');",
                  "  } else {",
                  "    pm.expect(body.success).to.equal(false);",
                  "    pm.expect(body.error).to.have.property('code', expectedErrorCode);",
                  "    pm.expect(body.meta).to.have.property('traceId');",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/set-initial-password",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "set-initial-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{initialPasswordToken}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Day 5 staff/admin initial-password consume flow. No Idempotency-Key header; success envelope data is { userId, status: \"ACTIVE\" }."
          }
        },
        {
          "name": "Register device token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('ADR 0004 device-token success envelope', function () {",
                  "  pm.expect(body.success).to.equal(true);",
                  "  pm.expect(body.statusCode).to.equal(200);",
                  "  pm.expect(body.data).to.have.property('userDeviceId').that.is.a('string').and.is.not.empty;",
                  "  pm.expect(body.data).to.have.property('fcmToken', pm.variables.get('fcmToken'));",
                  "  pm.expect(body.data).to.have.property('platform', 'ANDROID');",
                  "  pm.expect(body.data).to.have.property('isActive', true);",
                  "  pm.expect(body.meta).to.have.property('traceId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/device-token",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "device-token"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"{{fcmToken}}\",\n  \"platform\": \"ANDROID\"\n}"
            },
            "description": "Day 5 FCM device-token upsert. No Idempotency-Key header; expects 200 ApiResponse envelope."
          }
        },
        {
          "name": "Delete device token (expect 204)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});",
                  "pm.test('Response body is empty', function () {",
                  "  pm.expect(pm.response.text()).to.equal('');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/device-token",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "device-token"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"{{fcmToken}}\"\n}"
            },
            "description": "Day 5 FCM device-token deactivate/logout. No Idempotency-Key header; expects 204 No Content with empty body."
          }
        }
      ]
    },
    {
      "name": "Identity — Auth (Google OAuth)",
      "item": [
        {
          "name": "Login with Google ID token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('ADR 0004 success envelope with token bundle', function () {",
                  "  pm.expect(body.success).to.equal(true);",
                  "  pm.expect(body.statusCode).to.equal(200);",
                  "  pm.expect(body.data).to.have.property('accessToken').that.is.a('string').and.is.not.empty;",
                  "  pm.expect(body.data).to.have.property('refreshToken').that.is.a('string').and.is.not.empty;",
                  "  pm.expect(body.data.user.status).to.equal('ACTIVE');",
                  "});",
                  "if (body && body.data) {",
                  "  pm.collectionVariables.set('tokens', JSON.stringify(body.data));",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken || '');",
                  "  pm.collectionVariables.set('refreshToken', body.data.refreshToken || '');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "google"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}"
            }
          }
        },
        {
          "name": "Get current Google-created profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "me"]
            }
          }
        },
        {
          "name": "Complete Google-created passenger phone",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/users/me/complete-profile",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "users", "me", "complete-profile"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Identity — Admin-created System Admin",
      "item": [
        {
          "name": "Create passwordless System Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Created admin is pending initial password', function () {",
                  "  pm.expect(body.success).to.equal(true);",
                  "  pm.expect(body.statusCode).to.equal(201);",
                  "  pm.expect(body.data).to.have.property('userId').that.is.a('string').and.is.not.empty;",
                  "  pm.expect(body.data).to.have.property('email', pm.variables.get('createdAdminEmail'));",
                  "  pm.expect(body.data).to.have.property('role', 'SYSTEM_ADMIN');",
                  "  pm.expect(body.data).to.have.property('status', 'PENDING_INITIAL_PASSWORD');",
                  "  pm.expect(body.meta).to.have.property('traceId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{systemAdminAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "users"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{createdAdminEmail}}\",\n  \"displayName\": \"Admin Two\",\n  \"role\": \"SYSTEM_ADMIN\"\n}"
            },
            "description": "Creates a passwordless SYSTEM_ADMIN with status PENDING_INITIAL_PASSWORD; Day 5 flow generates a SET_INITIAL_PASSWORD token and sends the initial-password email link."
          }
        },
        {
          "name": "Login created admin before initial password (expect blocked)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status code is 403', function () {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "pm.test('Pending initial password login is blocked', function () {",
                  "  pm.expect(body.success).to.equal(false);",
                  "  pm.expect(body.statusCode).to.equal(403);",
                  "  pm.expect(body.error).to.have.property('code', 'AUTH_PENDING_INITIAL_PASSWORD');",
                  "  pm.expect(body.meta).to.have.property('traceId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{createdAdminEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Expected before initial password is set: created admin remains PENDING_INITIAL_PASSWORD and cannot login."
          }
        },
        {
          "name": "Resend operator user initial-password link",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Resend response shape matches Day 5 contract', function () {",
                  "  pm.expect(body.success).to.equal(true);",
                  "  pm.expect(body.statusCode).to.equal(200);",
                  "  pm.expect(body.data).to.have.property('userId', pm.variables.get('operatorUserId'));",
                  "  pm.expect(body.data).to.have.property('status', 'PENDING_INITIAL_PASSWORD');",
                  "  pm.expect(body.data).to.have.property('expiresAt').that.is.a('string').and.is.not.empty;",
                  "  pm.expect(body.meta).to.have.property('traceId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{operatorAdminAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/operator/users/{{operatorUserId}}/resend-initial-password",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "operator", "users", "{{operatorUserId}}", "resend-initial-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "description": "Day 5 OPERATOR_ADMIN resend for a same-operator user in PENDING_INITIAL_PASSWORD. No Idempotency-Key header; cross-operator targets expect 403."
          }
        }
      ]
    }
  ]
}
