    {
      "name": "03 - Tracking Data API (seed + authz required)",
      "description": "If downstream Trip/Booking/Parcel authz is unavailable, these requests should return 503 TRACKING_AUTH_UNAVAILABLE and still pass. When authz is available, they assert 200/403 data behavior.",
      "item": [
        {
          "name": "GET latest (happy) -> 200 or 503 authz unavailable",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrlService}}/v1/tracking/trips/{{tripId}}/latest",
              "host": [
                "{{baseUrlService}}"
              ],
              "path": [
                "api",
                "v1",
                "tracking",
                "trips",
                "{{tripId}}",
                "latest"
              ]
            },
            "description": "Reads Redis tracking:latest:{tripId}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is expected integration outcome', () => pm.expect([200, 503]).to.include(pm.response.code));",
                  "const env = pm.response.json();",
                  "pm.test('statusCode matches HTTP', () => pm.expect(env.statusCode).to.eql(pm.response.code));",
                  "pm.test('meta has timestamp', () => pm.expect(env.meta.timestamp).to.be.a('string').and.not.empty);",
                  "pm.test('traceId is string when present', () => { if (env.meta.traceId !== undefined) pm.expect(env.meta.traceId).to.be.a('string').and.not.empty; });",
                  "if (pm.response.code === 503) {",
                  "  pm.test('authz dependency unavailable is explicit', () => { pm.expect(env.success).to.eql(false); pm.expect(env.error.code).to.eql('TRACKING_AUTH_UNAVAILABLE'); });",
                  "}",
                  "if (pm.response.code === 200) {",
                  "  pm.test('envelope success=true', () => pm.expect(env.success).to.eql(true));",
                  "  pm.test('data.latest shape', () => {",
                  "    pm.expect(env.data.latest).to.be.an('object');",
                  "    pm.expect(env.data.latest.tripId).to.eql(pm.environment.get('tripId') || pm.collectionVariables.get('tripId'));",
                  "    pm.expect(env.data.latest.latitude).to.be.a('number');",
                  "    pm.expect(env.data.latest.longitude).to.be.a('number');",
                  "    pm.expect(env.data.latest.recordedAt).to.be.a('string');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET latest (cache miss) -> 200 null or 503 authz unavailable",
          "request": {
            "method": "GET",
            "header": [
              {
