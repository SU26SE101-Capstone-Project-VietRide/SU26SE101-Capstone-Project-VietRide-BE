                  "if (pm.response.code === 200) {",
                  "  pm.test('envelope success=true', () => pm.expect(env.success).to.eql(true));",
                  "  pm.test('data.latest = null', () => pm.expect(env.data.latest).to.eql(null));",
                  "}"
