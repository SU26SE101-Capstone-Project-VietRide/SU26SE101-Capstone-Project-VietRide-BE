{
  "info": {
    "name": "VietRide Tracking API",
    "description": "REST-only Postman collection for VietRide Tracking Service. WebSocket/realtime is intentionally excluded.\n\nRun order: 00 Health -> 01 Identity Login -> 02 Negative API -> 03 Tracking Data API.\n\nDirect Tracking service baseUrlService defaults to http://localhost:3001.\nTracking endpoints are under /v1/tracking/trips/* because controllers expose /v1 paths directly.\n\nFolder 02 needs no seed/token and verifies routing, validation, auth, and ApiResponse errors.\nFolder 03 needs accessToken, downstream Trip/Booking/Parcel tracking authorization, and seeded Redis/Postgres data.\n\nSeed data command:\n$env:TRACKING_DATABASE_URL=\"postgresql://vietride:vietride_dev@localhost:5432/vietride_tracking\"\n$env:REDIS_URL=\"redis://localhost:6379\"\nnode scripts/postman/seed-tracking-postman-data.js",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Health & Probes",
      "item": [
        {
          "name": "GET /health -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrlService}}/health",
              "host": [
                "{{baseUrlService}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness probe, no auth."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const env = pm.response.json();",
                  "pm.test('envelope success=true', () => pm.expect(env.success).to.eql(true));",
                  "pm.test('statusCode matches HTTP', () => pm.expect(env.statusCode).to.eql(pm.response.code));",
                  "pm.test('meta has timestamp', () => pm.expect(env.meta.timestamp).to.be.a('string').and.not.empty);",
                  "pm.test('traceId is string when present', () => { if (env.meta.traceId !== undefined) pm.expect(env.meta.traceId).to.be.a('string').and.not.empty; });",
                  "pm.test('data.status = ok', () => pm.expect(env.data.status).to.eql('ok'));",
                  "pm.test('data.service = tracking', () => pm.expect(String(env.data.service).toLowerCase()).to.eql('tracking'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /ready -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrlService}}/ready",
              "host": [
                "{{baseUrlService}}"
              ],
              "path": [
                "ready"
              ]
            },
            "description": "Readiness probe, no auth."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const env = pm.response.json();",
                  "pm.test('envelope success=true', () => pm.expect(env.success).to.eql(true));",
                  "pm.test('statusCode matches HTTP', () => pm.expect(env.statusCode).to.eql(pm.response.code));",
                  "pm.test('meta has timestamp', () => pm.expect(env.meta.timestamp).to.be.a('string').and.not.empty);",
                  "pm.test('traceId is string when present', () => { if (env.meta.traceId !== undefined) pm.expect(env.meta.traceId).to.be.a('string').and.not.empty; });",
                  "pm.test('data.status = ok', () => pm.expect(env.data.status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Auth (Identity login)",
      "item": [
        {
          "name": "POST /v1/auth/login -> save accessToken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{identityEmail}}\",\n  \"password\": \"{{identityPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrlGateway}}/v1/auth/login",
              "host": [
                "{{baseUrlGateway}}"
              ],
              "path": [
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Login through Gateway. Saves accessToken/userId/userRole for Tracking requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const env = pm.response.json();",
                  "pm.test('envelope success=true', () => pm.expect(env.success).to.eql(true));",
                  "pm.test('has accessToken', () => pm.expect(env.data.accessToken).to.be.a('string').and.not.empty);",
                  "if (env.data && env.data.accessToken) {",
                  "  pm.environment.set('accessToken', env.data.accessToken);",
                  "  if (env.data.user && env.data.user.id) pm.environment.set('userId', env.data.user.id);",
                  "  if (env.data.user && env.data.user.role) pm.environment.set('userRole', env.data.user.role);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
