        {
          "name": "GET trail page 1 -> 200 or 503 authz unavailable",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrlService}}/v1/tracking/trips/{{tripId}}/trail?page=1&pageSize=10&from={{startTime}}&to={{endTime}}",
              "host": [
