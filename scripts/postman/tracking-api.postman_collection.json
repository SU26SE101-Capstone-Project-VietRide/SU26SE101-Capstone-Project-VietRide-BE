                  "key": "from",
                  "value": "{{startTime}}"
                },
                {
                  "key": "to",
                  "value": "{{endTime}}"
                }
              ]
            },
            "description": "Reads gps_trails."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is expected integration outcome', () => pm.expect([200, 503]).to.include(pm.response.code));",
                  "const env = pm.response.json();",
                  "pm.test('statusCode matches HTTP', () => pm.expect(env.statusCode).to.eql(pm.response.code));",
                  "pm.test('meta has timestamp', () => pm.expect(env.meta.timestamp).to.be.a('string').and.not.empty);",
                  "pm.test('traceId is string when present', () => { if (env.meta.traceId !== undefined) pm.expect(env.meta.traceId).to.be.a('string').and.not.empty; });",
                  "if (pm.response.code === 503) {",
                  "  pm.test('authz dependency unavailable is explicit', () => { pm.expect(env.success).to.eql(false); pm.expect(env.error.code).to.eql('TRACKING_AUTH_UNAVAILABLE'); });",
                  "}",
                  "if (pm.response.code === 200) {",
                  "  pm.test('envelope success=true', () => pm.expect(env.success).to.eql(true));",
                  "  pm.test('pagination shape', () => {",
                  "    pm.expect(env.data).to.include.all.keys(['items','page','pageSize','totalItems','totalPages','hasNextPage','hasPreviousPage']);",
                  "    pm.expect(env.data.page).to.eql(1);",
                  "    pm.expect(env.data.pageSize).to.eql(10);",
                  "    pm.expect(env.data.items).to.be.an('array');",
                  "  });",
                  "  pm.test('items have GPS shape when present', () => { env.data.items.forEach((p) => { pm.expect(p.tripId).to.eql(pm.environment.get('tripId') || pm.collectionVariables.get('tripId')); pm.expect(p.latitude).to.be.a('number'); pm.expect(p.longitude).to.be.a('number'); pm.expect(p.recordedAt).to.be.a('string'); }); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET trail sortDir=desc -> 200 sorted or 503 authz unavailable",
