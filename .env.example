# VietRide backend — environment template
# Copy to .env (gitignored) and fill real values for local dev.

# ───────────────────────────────────────────────────
# Postgres (single cluster, 8 logical databases)
# ───────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vietride
POSTGRES_PASSWORD=vietride_dev
POSTGRES_SUPERUSER_PASSWORD=postgres
PGBOUNCER_PORT=6432

# Per-service DB connection strings (.NET reads from appsettings; this is for compose interpolation)
IDENTITY_DB=vietride_identity
TRIP_DB=vietride_trip
BOOKING_DB=vietride_booking
PAYMENT_DB=vietride_payment
PARCEL_DB=vietride_parcel
TRACKING_DB=vietride_tracking
NOTIFICATION_DB=vietride_notification
RAG_DB=vietride_rag

# Nest/Prisma services prefer their own URL over DATABASE_URL.
# Keep DATABASE_URL unset in the shared root .env unless you are running one service only.
TRACKING_DATABASE_URL=postgresql://vietride:vietride_dev@localhost:5432/vietride_tracking
NOTIFICATION_DATABASE_URL=postgresql://vietride:vietride_dev@localhost:5432/vietride_notification
RAG_DATABASE_URL=postgresql://vietride:vietride_dev@localhost:5432/vietride_rag

# ───────────────────────────────────────────────────
# Redis
# ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ───────────────────────────────────────────────────
# RabbitMQ
# ───────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=vietride
RABBITMQ_PASSWORD=vietride_dev
RABBITMQ_VHOST=/

# ───────────────────────────────────────────────────
# JWT
# ───────────────────────────────────────────────────
# Identity Service signs User Access Token with RS256 (private key); other services verify via JWKS.
JWT_PUBLIC_KEY_URL=http://identity:5001/v1/.well-known/jwks.json
JWT_ISSUER=vietride-identity
JWT_AUDIENCE=vietride-api
JWT_ACCESS_TOKEN_TTL_MIN=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Gateway signs Internal JWT with HS256 (shared secret); .NET services verify with same secret.
INTERNAL_JWT_SECRET=replace-me-with-32-byte-hex-secret
INTERNAL_JWT_TTL_SEC=120

# Gateway rate limit per BACKEND_SOURCE_OF_TRUTH §11.3 (default 120 req/min per IP per route).
RATE_LIMIT_DEFAULT_PER_MIN=120

# ───────────────────────────────────────────────────
# Service base URLs (Gateway proxy targets)
# ───────────────────────────────────────────────────
IDENTITY_BASE_URL=http://identity:5001
TRIP_BASE_URL=http://trip:5002
BOOKING_BASE_URL=http://booking:5003
PAYMENT_BASE_URL=http://payment:5004
PARCEL_BASE_URL=http://parcel:5005
TRACKING_BASE_URL=http://tracking:3001
NOTIFICATION_BASE_URL=http://notification:3002
RAG_BASE_URL=http://rag:3003

# Identity → Notification internal email endpoint (POST /internal/v1/emails).
# EMAIL_SERVICE_BASE_URL is the base URL Identity calls (BSOT §3.5). EMAIL_PROVIDER
# selects the IEmailService impl: SENDGRID = real delivery via Notification (set in
# docker-compose for container/prod); LOG (default) = log-only for local dev so
# Identity works without Notification running.
EMAIL_SERVICE_BASE_URL=http://notification:3002
EMAIL_PROVIDER=LOG
PUBLIC_APP_URL=http://localhost:5173

# ───────────────────────────────────────────────────
# Admin bootstrap
# ───────────────────────────────────────────────────
# Required for local Day-4+/Day-5+ audit E2E when the stack starts from an empty DB:
# copy these keys into your gitignored .env with local-only values so the Identity
# startup seeder can create a SYSTEM_ADMIN without manual DB seeding.
SYSTEM_ADMIN_BOOTSTRAP_EMAIL=admin@vietride.app
SYSTEM_ADMIN_BOOTSTRAP_PASSWORD=ChangeMeOnFirstLogin!
SYSTEM_ADMIN_BOOTSTRAP_DISPLAY_NAME=System Administrator

# ───────────────────────────────────────────────────
# External providers (Day 1 placeholders — fill when integrating)
# ───────────────────────────────────────────────────
# VNPay Sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://app.vietride.online/payments/return
VNPAY_IPN_URL=https://api.vietride.online/v1/payments/vnpay-ipn
VNPAY_PAYMENT_TIMEOUT_MINUTES=10

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@vietride.app

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# RAG service (apps/rag) — REQUIRED for the rag container to boot in prod.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# Cloudinary — REQUIRED for rag (document storage).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_RAG_FOLDER=rag/documents

# Notification push (apps/notification) — optional only outside production; production requires all three credentials.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

FCM_DRY_RUN=false
FCM_DRY_RUN_TOPIC=vietride-e2e-validation
# ───────────────────────────────────────────────────
# Observability (v1 = Sentry + UptimeRobot + Serilog/Winston per BSOT §9.13).
# Prometheus/Grafana/Tempo/Loki/OpenTelemetry deferred to v2.
# ───────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ───────────────────────────────────────────────────
# Service ports (override only if conflict)
# ───────────────────────────────────────────────────
GATEWAY_PORT=3000
IDENTITY_PORT=5001
TRIP_PORT=5002
BOOKING_PORT=5003
PAYMENT_PORT=5004
PARCEL_PORT=5005
TRACKING_PORT=3001
NOTIFICATION_PORT=3002
RAG_PORT=3003
