{
  "name": "vietride-backend",
  "version": "0.1.0",
  "private": true,
  "description": "VietRide capstone backend monorepo — 5 .NET services + 4 NestJS services + Gateway",
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "node .githooks/install.mjs",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "graph": "nx graph",
    "dev:gateway": "nx serve gateway",
    "dev:tracking": "nx serve tracking",
    "dev:notification": "nx serve notification",
    "dev:rag": "nx serve rag",
    "postman:day6:local": "node scripts/run-day6-newman-local.js",
    "postman:day7:local": "node scripts/run-day7-newman-local.js",
    "postman:day8:local": "node scripts/run-day8-newman-local.js",
    "postman:day9:local": "node scripts/run-day9-newman-local.js",
    "postman:day13:local": "node scripts/run-day13-newman-local.js",
    "postman:day15:local": "node scripts/run-day15-newman-local.mjs",
    "postman:day17:local": "node scripts/run-day17-newman-local.mjs",
    "postman:day11:local": "node scripts/run-day11-newman-local.js",
    "postman:day18:local": "node scripts/run-day18-newman-local.mjs",
    "postman:day18:crossday": "node scripts/run-day18-crossday-local.mjs",
    "e2e:day37": "node scripts/run-day37-subscription-e2e.mjs",
    "e2e:day36": "node scripts/run-day36-shuttle-e2e.mjs",
    "postman:full:local": "node scripts/run-full-e2e-local.mjs",
    "lint:ts": "nx run-many -t lint --exclude=\"VietRide.*\"",
    "test:ts": "nx run-many -t test --exclude=\"VietRide.*\" --ci --passWithNoTests",
    "build:ts": "nx run-many -t build --exclude=\"VietRide.*\""
  },
  "workspaces": [
    "apps/*",
    "libs/shared/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx-dotnet/core": "^3.0.2",
    "@nx/eslint": "22.7.4",
    "@nx/eslint-plugin": "22.7.4",
    "@nx/jest": "22.7.4",
    "@nx/js": "^22.7.4",
    "@nx/nest": "^22.7.4",
    "@nx/node": "^22.7.4",
    "@nx/web": "22.7.4",
    "@nx/webpack": "22.7.4",
    "@nx/workspace": "^22.7.4",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
