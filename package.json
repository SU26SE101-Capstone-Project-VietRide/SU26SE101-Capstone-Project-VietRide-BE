    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "^22.7.4",
    "prettier": "~3.6.2",
    "prisma": "^6.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
