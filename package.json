    "amqplib": "^0.10.4",
    "axios": "^1.6.0",
    "bullmq": "^5.77.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.10.0",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.10.1",
    "jose": "^5.10.0",
