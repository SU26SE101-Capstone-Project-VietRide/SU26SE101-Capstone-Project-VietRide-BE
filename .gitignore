*.dll
!**/wwwroot/**/*.dll
*.pdb
*.cache
*.nupkg
*.snupkg
*.publishsettings
*.publishproj
PublishProfiles/
*.[Pp]ublish.xml

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml
[Cc]overage*/

