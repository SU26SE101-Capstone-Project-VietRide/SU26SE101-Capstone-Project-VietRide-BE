node_modules/
dist/
.nx/cache
.nx/workspace-data
.angular/
.eslintcache
.tsbuildinfo
*.tsbuildinfo
.parcel-cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test output
coverage/
.nyc_output/
*.lcov
**/jest_html_reporters.html
playwright-report/
test-results/

# ── .NET 8 ───────────────────────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Oo]ut/
[Bb]uild/
[Bb]uilds/
[Ll]og/
[Ll]ogs/

# Claude Code / agent setup — per-member (each dev keeps their OWN; not shared, avoids conflicts).
# Covers .claude/ (agents, skills, hooks, settings*), the CLAUDE.md wrapper, AND AGENTS.md.
# AGENTS.md is per-member here too: teammates author their agent guides differently (e.g. their
# own NestJS agent conventions), so it is not shareable as a single file.
# Canonical SHARED truth stays tracked elsewhere and is unaffected:
#   BACKEND_SOURCE_OF_TRUTH.md, SU26SE101_VIETRIDE_technical_context_v7.md,
#   VietRide_API_Contract_v1.md, db-schema/, docs/adr/, docs/handoff/ — and .githooks/, which
#   enforce the hard invariants (CPM, banned deps, EOL, no Co-Authored-By) regardless of agent setup.
# NOTE: .gitignore alone does NOT untrack already-committed files — run once:
#   git rm -r --cached .claude CLAUDE.md AGENTS.md   (then commit). Coordinate / back up first.
.claude/
CLAUDE.md
AGENTS.md

# CodeGraph MCP — local symbol index (rebuilt per clone via `codegraph init -i`)
.codegraph/

# MCP server config — per-developer (machine-specific paths); each dev configures locally
.mcp.json

# Visual Studio + Rider + JetBrains
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.iml
*.user
*.suo
*.userprefs
*.userosscache
*.sln.docstates
*.svclog
.vshistory/

