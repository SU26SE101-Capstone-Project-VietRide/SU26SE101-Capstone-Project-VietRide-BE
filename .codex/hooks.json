{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Task|Agent|Workflow|EnterWorktree|ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/pre-guard.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/format-on-edit.mjs"
          }
        ]
      }
    ]
  }
}
