generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/tracking-prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("TRACKING_DATABASE_URL")
  schemas  = ["vietride_tracking"]
}

enum OutboxEventStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED

  @@map("outbox_event_status")
  @@schema("vietride_tracking")
}

model GpsTrail {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId     String   @map("trip_id") @db.Uuid
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  speedKmh   Decimal? @map("speed_kmh") @db.Decimal(6, 2)
  headingDeg Decimal? @map("heading_deg") @db.Decimal(5, 2)
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tripId, recordedAt], map: "uq_gps_trails_trip_recorded_at")
  @@index([recordedAt], map: "idx_gps_trails_recorded_at")
  @@map("gps_trails")
  @@schema("vietride_tracking")
}

model OutboxEvent {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType   String            @map("event_type") @db.VarChar(100)
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  retryCount  Int               @default(0) @map("retry_count")
  lastError   String?           @map("last_error")
  nextRetryAt DateTime?         @map("next_retry_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt DateTime?         @map("published_at") @db.Timestamptz(6)

  @@index([status, createdAt], map: "idx_outbox_events_status_created")
  @@index([status, nextRetryAt], map: "idx_outbox_events_status_next_retry")
  @@index([status, updatedAt], map: "idx_outbox_events_status_updated")
  @@map("outbox_events")
  @@schema("vietride_tracking")
}

model OutboxDlq {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @unique(map: "uq_outbox_dlq_event_id") @map("event_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(100)
  payload     Json
  retryCount  Int      @map("retry_count")
  lastError   String   @map("last_error") @db.Text
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  terminalAt  DateTime @default(now()) @map("terminal_at") @db.Timestamptz(6)

  @@index([terminalAt, eventId], map: "idx_outbox_dlq_terminal_event_id")
  @@map("outbox_dlq")
  @@schema("vietride_tracking")
}
