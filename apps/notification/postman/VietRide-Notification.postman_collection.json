    {
      "name": "06 - Internal Emails (direct service :3002)",
      "description": "POST /internal/v1/emails — KHÔNG qua gateway, gọi trực tiếp {{baseUrlService}}. Pre-request folder tự ký internal JWT HS256. Endpoint render template TRƯỚC khi enqueue: templateData phải đủ biến bắt buộc của templateKey (vd OPERATOR_SUBSCRIPTION_NOTICE cần 'message').",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let secret = pm.environment.get('internalJwtSecret') || pm.collectionVariables.get('internalJwtSecret') || 'replace-me-with-32-byte-hex-secret';",
              "secret = String(secret).trim().replace(/^\\\"|\\\"$/g, '');",
              "if (!secret || secret.length < 32) { throw new Error('internalJwtSecret is missing or shorter than 32 chars'); }",
              "pm.environment.set('internalJwtSecret', secret);",
              "function b64url(input) {",
              "  const wa = (typeof input === 'string') ? CryptoJS.enc.Utf8.parse(input) : input;",
              "  return CryptoJS.enc.Base64.stringify(wa).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "}",
              "const now = Math.floor(Date.now() / 1000);",
              "const header = { alg: 'HS256', typ: 'JWT' };",
              "const payload = { sub: 'qa-internal-tester', role: 'INTERNAL', iss: 'vietride-gateway', aud: 'vietride-internal', iat: now, exp: now + 120, reqId: 'qa-' + now };",
              "const signingInput = b64url(JSON.stringify(header)) + '.' + b64url(JSON.stringify(payload));",
              "const sig = b64url(CryptoJS.HmacSHA256(signingInput, secret));",
              "const token = signingInput + '.' + sig;",
              "pm.environment.set('internalToken', token);",
              "pm.variables.set('internalToken', token);"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "POST email (happy, payload đúng biến) -> 202",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Internal-Auth", "value": "Bearer {{internalToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toEmail\": \"{{toEmail}}\",\n  \"templateKey\": \"OPERATOR_SUBSCRIPTION_NOTICE\",\n  \"templateData\": {\n    \"message\": \"Goi dich vu cua ban se het han sau 7 ngay. Vui long gia han.\",\n    \"title\": \"Thong bao goi dich vu VietRide\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrlService}}/internal/v1/emails",
              "host": ["{{baseUrlService}}"],
              "path": ["internal", "v1", "emails"]
            },
            "description": "Enqueue email. templateData CÓ 'message' (biến bắt buộc của OPERATOR_SUBSCRIPTION_NOTICE) -> render ok -> 202 PENDING. (Gửi SendGrid thật do worker; safe-local dùng fake provider.)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));",
                  "const env = pm.response.json();",
                  "pm.test('envelope success=true', () => pm.expect(env.success).to.eql(true));",
                  "pm.test('có đủ field delivery', () => pm.expect(env.data).to.include.all.keys(['id','toEmail','templateKey','status','createdAt']));",
                  "pm.test('status khởi tạo = PENDING', () => pm.expect(env.data.status).to.eql('PENDING'));",
                  "pm.test('toEmail đúng', () => pm.expect(env.data.toEmail).to.eql(pm.environment.get('toEmail')));",
                  "pm.test('response < 1500ms', () => pm.expect(pm.response.responseTime).to.be.below(1500));",
                  "if (env.data && env.data.id) { pm.environment.set('emailDeliveryId', env.data.id); }"
                ]
              }
            }
          ]
        },
