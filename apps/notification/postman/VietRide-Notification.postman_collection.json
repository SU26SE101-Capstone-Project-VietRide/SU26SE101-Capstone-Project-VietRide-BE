    {
      "name": "04 - Notifications: Mark read",
      "description": "Dùng {{notificationId}} từ folder 02 (Seed Event). Nếu bỏ folder 02, set {{seededNotificationId}} (fallback/debug).",
      "item": [
        {
          "name": "PATCH mark read -> 204",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"read\": true\n}" },
            "url": {
              "raw": "{{baseUrlGateway}}{{notificationsPath}}/{{notificationId}}",
              "host": ["{{baseUrlGateway}}{{notificationsPath}}"],
              "path": ["{{notificationId}}"]
            },
            "description": "Đánh dấu đã đọc -> 204 không body."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('notificationId')) {",
                  "  const seeded = pm.environment.get('seededNotificationId');",
                  "  if (seeded) { pm.environment.set('notificationId', seeded); }",
                  "  else { console.warn('Chưa có notificationId — chạy folder 02 trước hoặc set seededNotificationId.'); }",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));",
                  "pm.test('không có body', () => pm.expect(pm.response.text()).to.be.empty);",
                  "pm.test('response < 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH mark read (gọi lại) -> 204 (idempotency)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"read\": true\n}" },
            "url": {
              "raw": "{{baseUrlGateway}}{{notificationsPath}}/{{notificationId}}",
              "host": ["{{baseUrlGateway}}{{notificationsPath}}"],
              "path": ["{{notificationId}}"]
            },
            "description": "Idempotency: mark read lần 2 vẫn 204, không double-write (service bỏ qua nếu đã readAt)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204 (idempotent)', () => pm.response.to.have.status(204));",
                  "pm.test('không có body', () => pm.expect(pm.response.text()).to.be.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET unreadOnly sau mark read -> id biến mất",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrlGateway}}{{notificationsPath}}?unreadOnly=true&pageSize=100",
              "host": ["{{baseUrlGateway}}{{notificationsPath}}"],
              "query": [
                { "key": "unreadOnly", "value": "true" },
                { "key": "pageSize", "value": "100" }
              ]
            },
            "description": "Side-effect: notification vừa mark read không còn trong list unreadOnly."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
