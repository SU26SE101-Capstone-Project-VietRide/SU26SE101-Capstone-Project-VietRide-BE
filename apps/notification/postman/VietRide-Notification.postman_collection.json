      ]
    },
    {
      "name": "01 - Auth (Identity login)",
      "item": [
        {
          "name": "POST /v1/auth/login (happy) -> lưu accessToken",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{identityEmail}}\",\n  \"password\": \"{{identityPassword}}\"\n}" },
            "url": { "raw": "{{baseUrlGateway}}/v1/auth/login", "host": ["{{baseUrlGateway}}"], "path": ["v1", "auth", "login"] },
            "description": "Login lấy user access token thật từ Identity (qua gateway). Lưu accessToken + userId + role."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const env = pm.response.json();",
                  "pm.test('envelope success=true', () => pm.expect(env.success).to.eql(true));",
                  "pm.test('có accessToken', () => pm.expect(env.data.accessToken).to.be.a('string').and.not.empty);",
                  "pm.test('có user.id', () => pm.expect(env.data.user.id).to.be.a('string').and.not.empty);",
                  "pm.test('response < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "if (env.data && env.data.accessToken) {",
                  "  pm.environment.set('accessToken', env.data.accessToken);",
                  "  pm.environment.set('userId', env.data.user.id);",
                  "  pm.environment.set('userRole', env.data.user.role);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /v1/auth/login (sai mật khẩu) -> 4xx",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{identityEmail}}\",\n  \"password\": \"wrong-password-xxxx\"\n}" },
            "url": { "raw": "{{baseUrlGateway}}/v1/auth/login", "host": ["{{baseUrlGateway}}"], "path": ["v1", "auth", "login"] },
            "description": "Negative: sai mật khẩu. Mã lỗi cụ thể do Identity quyết định (cần xác nhận — TEST_PLAN §8 Q5)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 4xx', () => pm.expect(pm.response.code).to.be.within(400, 499));",
                  "pm.test('envelope success=false', () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Seed Event (RabbitMQ -> consumer -> notification)",
      "description": "Test luồng event-driven thật: publish domain event vào exchange vietride.events qua RabbitMQ Management API, rồi poll list tới khi consumer + mapper tạo notification trong DB. ĐIỀU KIỆN BẮT BUỘC (theo code): set properties.message_id; payload đúng schema (userId/bookingId là uuid); payload.userId = {{userId}}. Đặt Runner Delay ~1000ms để bước poll có khoảng nghỉ.",
      "item": [
        {
          "name": "PUBLISH booking.booking.confirmed",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{rabbitMgmtUser}}", "type": "string" },
                { "key": "password", "value": "{{rabbitMgmtPass}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"properties\": { \"message_id\": \"{{seedMessageId}}\" },\n  \"routing_key\": \"booking.booking.confirmed\",\n  \"payload\": \"{\\\"userId\\\":\\\"{{userId}}\\\",\\\"bookingId\\\":\\\"{{seedBookingId}}\\\",\\\"bookingCode\\\":\\\"VR-QA-001\\\",\\\"routeName\\\":\\\"Sai Gon - Da Lat\\\"}\",\n  \"payload_encoding\": \"string\"\n}"
            },
            "url": {
              "raw": "{{rabbitMgmtUrl}}/api/exchanges/{{rabbitVhost}}/{{rabbitExchange}}/publish",
              "host": ["{{rabbitMgmtUrl}}"],
              "path": ["api", "exchanges", "{{rabbitVhost}}", "{{rabbitExchange}}", "publish"]
            },
            "description": "Publish event BOOKING_CONFIRMED. Sinh message_id + bookingId mới mỗi lần ở pre-request. routed=true nghĩa là có queue nhận (consumer đang bind)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function uuidv4() {",
                  "  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {",
                  "    const r = Math.random() * 16 | 0; const v = c === 'x' ? r : (r & 0x3 | 0x8); return v.toString(16);",
                  "  });",
                  "}",
                  "if (!pm.environment.get('userId')) { console.warn('Chưa có userId — chạy folder 01 Login trước.'); }",
                  "pm.environment.set('seedBookingId', uuidv4());",
                  "pm.environment.set('seedMessageId', 'qa-seed-' + Date.now());",
                  "pm.environment.set('seedPollAttempt', '0');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 (Mgmt API)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('routed = true (có queue nhận event)', () => pm.expect(body.routed).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "POLL list cho tới khi thấy notification (capture id)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrlGateway}}{{notificationsPath}}?pageSize=20&sortBy=createdAt&sortDir=desc",
              "host": ["{{baseUrlGateway}}{{notificationsPath}}"],
              "query": [
                { "key": "pageSize", "value": "20" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortDir", "value": "desc" }
              ]
            },
            "description": "Poll tới khi tìm thấy notification có data.bookingId == {{seedBookingId}}. Tự retry tối đa 10 lần (cần Runner Delay ~1000ms). Khi thấy: lưu {{notificationId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const MAX = 10;",
                  "let attempt = parseInt(pm.environment.get('seedPollAttempt') || '0', 10);",
                  "const target = pm.environment.get('seedBookingId');",
                  "let found = null;",
                  "if (pm.response.code === 200) {",
                  "  const env = pm.response.json();",
                  "  if (env.data && Array.isArray(env.data.items)) {",
                  "    found = env.data.items.find((n) => n.data && n.data.bookingId === target);",
                  "  }",
                  "}",
                  "if (found) {",
                  "  pm.environment.set('notificationId', found.id);",
                  "  pm.environment.set('seedPollAttempt', '0');",
                  "  pm.test('Seeded notification xuất hiện', () => pm.expect(found).to.be.an('object'));",
                  "  pm.test('type = BOOKING_CONFIRMED', () => pm.expect(found.type).to.eql('BOOKING_CONFIRMED'));",
                  "  pm.test('notification thuộc về user hiện tại', () => pm.expect(found.userId).to.eql(pm.environment.get('userId')));",
                  "  pm.test('readAt = null (mới tạo, chưa đọc)', () => pm.expect(found.readAt).to.eql(null));",
                  "} else {",
                  "  attempt += 1;",
                  "  pm.environment.set('seedPollAttempt', String(attempt));",
                  "  if (attempt < MAX) {",
                  "    console.log('Chưa thấy notification, retry lần ' + attempt + '/' + MAX);",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "  } else {",
                  "    pm.environment.set('seedPollAttempt', '0');",
                  "    pm.test('Notification xuất hiện sau ' + MAX + ' lần poll', () => {",
                  "      pm.expect.fail('Không thấy notification cho bookingId ' + target + '. Kiểm tra: (1) message_id đã set? (2) payload userId/bookingId hợp lệ uuid? (3) payload.userId == userId login? (4) consumer/queue đang chạy? Xem log service.');",
                  "    });",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Notifications: List (User API)",
      "item": [
        {
          "name": "GET list (happy) -> fallback bắt notificationId",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrlGateway}}{{notificationsPath}}?page=1&pageSize=20&sortBy=createdAt&sortDir=desc",
              "host": ["{{baseUrlGateway}}{{notificationsPath}}"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortDir", "value": "desc" }
              ]
            },
            "description": "List lịch sử notification. Kiểm tra envelope phân trang. Nếu chưa có notificationId (bỏ qua folder 02) thì bắt items[0].id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const env = pm.response.json();",
                  "pm.test('envelope success=true', () => pm.expect(env.success).to.eql(true));",
                  "pm.test('có đủ field phân trang', () => pm.expect(env.data).to.have.all.keys(['items','page','pageSize','totalItems','totalPages','hasNextPage','hasPreviousPage']));",
                  "pm.test('items là array', () => pm.expect(env.data.items).to.be.an('array'));",
                  "pm.test('pageSize phản ánh query (20)', () => pm.expect(env.data.pageSize).to.eql(20));",
                  "pm.test('response < 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "if (env.data.items.length > 0) {",
                  "  const n = env.data.items[0];",
                  "  pm.test('item có đủ field bắt buộc', () => pm.expect(n).to.include.all.keys(['id','userId','type','title','body','data','readAt','createdAt']));",
                  "  pm.test('notification thuộc về user hiện tại', () => pm.expect(n.userId).to.eql(pm.environment.get('userId')));",
                  "  if (!pm.environment.get('notificationId')) { pm.environment.set('notificationId', n.id); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET list ?unreadOnly=true",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrlGateway}}{{notificationsPath}}?unreadOnly=true",
              "host": ["{{baseUrlGateway}}{{notificationsPath}}"],
              "query": [{ "key": "unreadOnly", "value": "true" }]
            },
            "description": "Lọc chưa đọc — mọi item readAt = null."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const env = pm.response.json();",
                  "pm.test('mọi item readAt = null', () => env.data.items.forEach((n) => pm.expect(n.readAt, 'item ' + n.id).to.eql(null)));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET list ?pageSize=101 -> 400",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
