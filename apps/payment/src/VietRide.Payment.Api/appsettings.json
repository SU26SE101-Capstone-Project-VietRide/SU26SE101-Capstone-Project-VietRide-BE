{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=vietride_payment;Username=vietride;Password=vietride_dev;Pooling=true"
  },
  "Hangfire": {
    "WorkerCount": 2
  },
  "INTERNAL_JWT_SECRET": "",
  "REDIS_URL": "localhost:6379",
  "VnPay": {
    "TmnCode": "",
    "HashSecret": "",
    "BaseUrl": "https://sandbox.vnpayment.vn",
    "ReturnUrl": "https://app.vietride.app/payments/return",
    "IpnUrl": "https://api.vietride.app/v1/payments/vnpay-topup-ipn",
    "MinimumTopUpAmount": 10000
  },
  "InvoicePdf": {
    "Provider": "PDFsharp-MigraDoc",
    "MaxAttempts": 5,
    "StaleAfterMinutes": 15,
    "ReconciliationCron": "*/5 * * * *",
    "PublisherName": "VIETRIDE",
    "PublisherTaxCode": "Cập nhật theo hồ sơ pháp nhân",
    "PublisherAddress": "Việt Nam",
    "VatNote": "Giá dịch vụ đã bao gồm thuế giá trị gia tăng theo quy định hiện hành."
  },
  "InvoiceStorage": {
    "Bucket": "",
    "StableBaseUrl": "https://api.vietride.online",
    "SignedUrlTtlMinutes": 60
  },
  "OperatorWeb": {
    "InvoiceDetailBaseUrl": "https://operator.vietride.app/invoices"
  },
  "InvoiceBackfill": {
    "Enabled": true,
    "MaxBatchSize": 100
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "vietride",
    "Password": "vietride_dev",
    "VirtualHost": "/",
    "ExchangeName": "vietride.events",
    "Outbox": {
      "PollInterval": "00:00:05",
      "BatchSize": 50,
      "MaxRetryCount": 10
    }
  },
  "AllowedHosts": "*"
}
